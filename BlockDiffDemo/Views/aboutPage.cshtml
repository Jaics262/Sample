@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Value("title")</title>
    <style>
        body { font-family: Georgia, serif; margin: 0; color: #1b264f; background: #fff; }
        main { max-width: 720px; margin: 0 auto; padding: 32px 24px 64px; }
        h1 { font-size: 40px; margin: 0 0 12px; }
        p { font-size: 18px; line-height: 1.5; }
    </style>
</head>
<body>
    <main>
        <h1>@Model.Value("title")</h1>
        <p>@Model.Value("summary")</p>
        <p>@Model.Value("body")</p>
    </main>
</body>
</html>
