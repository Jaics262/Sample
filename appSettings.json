{
    "NLog": {
        "targets": {
            "logfile": {
                "type": "file",
                "fileName": "${{basedir}}/Poller/{0}/logs/${{shortdate}}.log",
                "maxArchiveDays": 180,
                "layout": "${longdate} ${uppercase:${level}} ${message}"
            },
            "console": {
                "type": "console",
                "layout": "${longdate} ${uppercase:${level}} ${message}"
            }
        }
    }
}
