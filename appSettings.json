{
    "Serilog": {
        "file": {
            "path": "Poller/{0}/logs/log.log",
            "retainedFileTimeLimitDays": 180,
            "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.ffff} {Level:u} {Message:lj}{NewLine}"
        },
        "console": {
            "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.ffff} {Level:u} {Message:lj}{NewLine}"
        }
    }
}
